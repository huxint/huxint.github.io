---
interface Props {
  figure: {
    src: string;
    width: number;
    height: number;
    alt: string;
    caption: string;
  };
}
const { figure } = Astro.props;
---

<figure class="project-figure" data-figure>
  <button
    class="figure-frame"
    type="button"
    data-figure-open
    aria-label={`放大图片：${figure.alt}`}
  >
    <img
      src={figure.src}
      width={figure.width}
      height={figure.height}
      alt={figure.alt}
      loading="lazy"
      decoding="async"
    />
  </button>
  <p class="figure-missing">图片暂时无法加载。{figure.alt}。</p>
  <figcaption>{figure.caption}</figcaption>
</figure>
