---
import { render } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate } from '../lib/posts';
import { momentDate, type Moment } from '../lib/life';

interface Props {
  moment: Moment;
}
const { moment } = Astro.props;
const { Content } = await render(moment);
const { weekday } = momentDate(moment);
const date = formatDate(moment.data.date);
const datetime = moment.data.date.toISOString();
const { location } = moment.data;
const caption = [date, location].filter(Boolean).join(' · ');
---

<article
  class="moment"
  id={moment.id}
  aria-label={`${date} 的记录`}
  data-caption={caption}
>
  <header class="moment-header">
    <h1><time datetime={datetime}>{date}</time></h1>
    <div class="moment-meta">
      <span>{weekday}</span>
      {
        location && (
          <span class="moment-location">
            <Icon name="pin" size={13} />
            {location}
          </span>
        )
      }
      {moment.data.draft && <span class="draft-badge">草稿</span>}
    </div>
  </header>
  <div class="prose moment-text">
    <Content />
  </div>
</article>
