---
import { render } from 'astro:content';
import { formatDate } from '../lib/posts';
import { momentWeekday, type Moment } from '../lib/life';

interface Props {
  moment: Moment;
}
const { moment } = Astro.props;
const { Content } = await render(moment);
const { date: datetime, location, draft } = moment.data;
const date = formatDate(datetime);
---

<article
  class="moment"
  id={moment.id}
  aria-label={`${date} 的记录`}
  data-caption={[date, location].filter(Boolean).join(' · ')}
>
  <div class="moment-info">
    <a class="back-link" href="/life/">← 所有记录</a>
    <p class="moment-meta">
      <span>{momentWeekday(moment)}</span>
      {location && <span>{location}</span>}
      {draft && <span class="draft-badge">草稿</span>}
    </p>
  </div>
  <h1 class="page-title">
    <time datetime={datetime.toISOString()}>{date}</time>
  </h1>
  <div class="prose moment-text">
    <Content />
  </div>
</article>
