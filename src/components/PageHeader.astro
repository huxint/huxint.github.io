---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<header class="page-header rail-grid">
  {
    Astro.slots.has('rail') && (
      <div class="rail">
        <slot name="rail" />
      </div>
    )
  }
  <div>
    <h1><slot name="title">{title}</slot></h1>
    <slot />
  </div>
</header>

<style>
  .page-header {
    margin-bottom: 48px;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(34px, 4vw, 44px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .page-header :global(:where(p)) {
    max-width: 36em;
    margin-top: 14px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
  }
  @media (max-width: 720px) {
    .page-header {
      margin-bottom: 36px;
    }
    .rail {
      margin-bottom: 12px;
    }
    h1 {
      font-size: 32px;
    }
    .page-header :global(:where(p)) {
      margin-top: 10px;
      font-size: 15px;
    }
  }
</style>
