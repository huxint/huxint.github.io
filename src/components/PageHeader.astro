---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<header class="page-header rail-grid">
  {
    Astro.slots.has('rail') && (
      <div class="rail">
        <slot name="rail" />
      </div>
    )
  }
  <div>
    <h1 class="page-title"><slot name="title">{title}</slot></h1>
    <slot />
  </div>
</header>

<style>
  .page-header {
    margin-bottom: 48px;
  }
  .page-header :global(:where(.lede)) {
    margin-top: 12px;
  }
  @media (max-width: 720px) {
    .page-header {
      margin-bottom: 32px;
    }
    .rail {
      margin-bottom: 10px;
    }
    .page-header :global(:where(.lede)) {
      margin-top: 8px;
    }
  }
</style>
