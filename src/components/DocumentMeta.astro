---
import { formatDate, readingMinutes, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const updated = data.updatedDate;
---

<details class="doc-meta" data-pagefind-ignore>
  <summary>
    <span class="doc-meta-label">
      <span class="doc-meta-badge">YAML</span>
      <span>文档信息</span>
    </span>
    <span class="doc-meta-summary">
      {formatDate(data.pubDate)} · 约 {readingMinutes(post.body)} 分钟
    </span>
    <span class="doc-meta-chevron" aria-hidden="true"></span>
  </summary>
  <div class="doc-meta-body">
    <dl class="doc-meta-grid">
      <div class="doc-meta-wide">
        <dt>title</dt>
        <dd>{data.title}</dd>
      </div>
      <div>
        <dt>published</dt>
        <dd>
          <time datetime={data.pubDate.toISOString()}>
            {formatDate(data.pubDate)}
          </time>
        </dd>
      </div>
      <div>
        <dt>updated</dt>
        <dd>{updated ? formatDate(updated) : '—'}</dd>
      </div>
      <div>
        <dt>reading</dt>
        <dd>约 {readingMinutes(post.body)} 分钟</dd>
      </div>
      <div>
        <dt>slug</dt>
        <dd><code>{post.id}</code></dd>
      </div>
      <div class="doc-meta-wide">
        <dt>tags</dt>
        <dd class="doc-meta-tags">
          {
            data.tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))
          }
        </dd>
      </div>
    </dl>
  </div>
</details>
