---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="footer-inner">
    <p>© {new Date().getUTCFullYear()} {site.name}</p>
    <nav class="footer-links" aria-label="页脚">
      <a href={site.github}><Icon name="github" size={15} />GitHub</a>
      <a href="/stickers/">表情</a>
      <a href="/rss.xml"><Icon name="rss" size={15} />RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    color: var(--faint);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--gutter);
    align-items: center;
    width: min(100% - var(--page-margin) * 2, var(--wide));
    margin: 0 auto;
    padding: 22px 0 30px;
  }
  .footer-links {
    display: flex;
    gap: 24px;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 32px;
    transition: color var(--dur-fast) ease;
  }
  .footer-links a:hover {
    color: var(--text);
  }
  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      padding: 18px 0 26px;
    }
    .footer-links {
      gap: 18px;
    }
  }
  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
