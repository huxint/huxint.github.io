---
import Icon from './Icon.astro';
---

<div class="gorilla-avatar" data-gorilla>
  <div class="gorilla-stage">
    <span class="sr-only" role="status" data-gorilla-status></span>
    <img
      class="gorilla-poster"
      src="/images/gorilla-portrait.webp"
      width="640"
      height="640"
      alt="一只微微歪头、双手撑地的灰色小猩猩"
      fetchpriority="high"
    />
    <canvas
      class="gorilla-canvas"
      role="img"
      aria-label="双手撑地的 3D 小猩猩"
      aria-describedby="gorilla-instructions"
      tabindex="-1"
      hidden></canvas>
  </div>
  <div class="gorilla-caption">
    <div class="gorilla-controls" hidden>
      <button class="gorilla-greet" type="button" data-gorilla-greet
        >打个招呼</button
      >
      <button
        class="gorilla-tool"
        type="button"
        data-gorilla-reset
        aria-label="重置猩猩视角"
        title="重置视角"><Icon name="rotate" size={14} /></button
      >
      <button
        class="gorilla-tool gorilla-motion"
        type="button"
        data-gorilla-motion
        aria-label="暂停猩猩动画"
        title="暂停动画"
        aria-pressed="false"
        ><span class="gorilla-pause"><Icon name="pause" size={14} /></span><span
          class="gorilla-play"><Icon name="play" size={14} /></span
        ></button
      >
    </div>
  </div>
  <p class="sr-only" id="gorilla-instructions">
    拖动可旋转，点击会点头。键盘左右方向键旋转，Home 键恢复视角，Enter
    或空格键打招呼。
  </p>
</div>

<script>
  const avatar = document.querySelector<HTMLElement>('[data-gorilla]')!;
  const visibility = new IntersectionObserver(
    async ([entry]) => {
      if (!entry.isIntersecting) return;
      visibility.disconnect();
      try {
        const { mountGorilla } = await import('../scripts/gorilla-scene');
        mountGorilla(avatar);
      } catch {
        avatar.dataset.state = 'fallback';
      }
    },
    { rootMargin: '120px' },
  );
  visibility.observe(avatar);
</script>

<style>
  .gorilla-avatar {
    display: block;
    width: 100%;
  }
  .gorilla-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }
  .gorilla-canvas,
  .gorilla-poster {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gorilla-canvas {
    cursor: grab;
    touch-action: pan-y;
  }
  .gorilla-canvas:active {
    cursor: grabbing;
  }
  .gorilla-caption {
    min-height: 40px;
    margin-top: 6px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 8px;
  }
  .gorilla-controls {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .gorilla-controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    border: 0;
    background: transparent;
    color: var(--muted);
    border-radius: var(--radius-sm);
  }
  .gorilla-controls button:hover {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }
  .gorilla-greet {
    font-size: var(--text-sm);
    padding: 0 10px;
    gap: 4px;
  }
  .gorilla-tool {
    width: 34px;
    padding: 0;
  }
  .gorilla-play,
  [aria-pressed='true'] .gorilla-pause {
    display: none;
  }
  [aria-pressed='true'] .gorilla-play {
    display: block;
  }
  @media (max-width: 720px) {
    .gorilla-caption {
      margin-top: 0;
    }
    .gorilla-controls button {
      min-height: 40px;
    }
    .gorilla-tool {
      width: 38px;
    }
  }
  @media print {
    .gorilla-canvas,
    .gorilla-controls {
      display: none !important;
    }
    .gorilla-poster {
      display: block !important;
    }
  }
</style>
