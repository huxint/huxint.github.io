---
import type { Post } from '../lib/posts';
import { readingMinutes, shortDate, tagHref, yearOf } from '../lib/posts';
interface Props {
  posts: Post[];
  headingLevel?: 'h2' | 'h3';
}
const { posts, headingLevel: Heading = 'h2' } = Astro.props;
const groups = Map.groupBy(posts, (post) => yearOf(post.data.pubDate));
---

{
  [...groups].map(([year, posts]) => (
    <section class="year-group">
      <p class="year-label">
        {year}
        <small>{posts.length} 篇</small>
      </p>
      <ol aria-label={`${year} 年的文章`}>
        {posts.map((post) => (
          <li class="year-entry post-item">
            <p class="entry-date">
              <time datetime={post.data.pubDate.toISOString()}>
                {shortDate(post.data.pubDate)}
              </time>
              <span>{readingMinutes(post.body)} 分钟</span>
            </p>
            <div class="post-body">
              <Heading class="post-title">
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                {post.data.draft && <span class="draft-badge">草稿</span>}
              </Heading>
              <p class="post-summary">{post.data.description}</p>
              <p class="tag-links">
                {post.data.tags.map((tag) => (
                  <a href={tagHref(tag)}>{tag}</a>
                ))}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))
}

<style>
  .post-item {
    padding-block: 16px;
  }
  .post-body {
    max-width: var(--measure);
  }
  .post-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .post-title a {
    transition: color var(--dur-fast) ease;
  }
  .post-title a:hover {
    color: var(--accent-ink);
  }
  .post-title .draft-badge {
    margin-left: 8px;
    vertical-align: 3px;
  }
  .post-summary {
    margin-top: 4px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }
  .tag-links {
    margin-top: 6px;
  }
  @media (max-width: 720px) {
    .post-item {
      padding-block: 14px;
    }
    .post-title {
      font-size: 19px;
    }
  }
</style>
