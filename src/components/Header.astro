---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
const path = Astro.url.pathname;
const links = [
  {
    href: '/',
    label: '文章',
    active: path === '/' || path.startsWith('/posts/'),
  },
  { href: '/life/', label: '生活', active: path.startsWith('/life/') },
  { href: '/projects/', label: '项目', active: path.startsWith('/projects/') },
  { href: '/tags/', label: '标签', active: path.startsWith('/tags/') },
  { href: '/about/', label: '关于', active: path.startsWith('/about/') },
];
---

<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label={`${site.name} 首页`}
      >{site.name}<span>.</span></a
    >
    <nav class="site-nav" aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={{ active: link.active }}
            aria-current={
              link.active
                ? path === link.href
                  ? 'page'
                  : 'location'
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <a
        class="icon-button"
        href="/search/"
        aria-label="搜索文章"
        aria-current={path === '/search/' ? 'page' : undefined}
        aria-keyshortcuts="/ Control+K Meta+K"
        title="搜索文章（/）"><Icon name="search" size={18} /></a
      >
      <ThemeToggle />
    </div>
  </div>
</header>
<script>
  import '../scripts/theme';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    transition: border-color var(--dur-base) ease;
    view-transition-name: site-header;
  }
  .site-header:global(.is-scrolled) {
    border-bottom-color: var(--rule);
  }
  .header-inner {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr) auto;
    column-gap: var(--gutter);
    align-items: center;
    width: min(100% - var(--page-margin) * 2, var(--wide));
    height: var(--header-height);
    margin: 0 auto;
  }
  .wordmark {
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.035em;
    line-height: 1;
    transition: color var(--dur-fast) ease;
  }
  .wordmark:hover {
    color: var(--accent-ink);
  }
  .wordmark span {
    color: var(--accent);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 100%;
  }
  .site-nav a {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    color: var(--muted);
    font-size: var(--text-md);
    line-height: 1;
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--accent);
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity var(--dur-fast) ease,
      transform var(--dur-base) var(--ease-out);
  }
  .site-nav a:hover {
    color: var(--text);
  }
  .site-nav a.active {
    color: var(--text);
    font-weight: var(--weight-medium);
  }
  .site-nav a.active::after {
    opacity: 1;
    transform: none;
  }
  .header-tools {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-right: -10px;
  }
  .header-tools [aria-current] {
    color: var(--accent-ink);
  }
  /* On a phone the wordmark scrolls away and one row stays: the header
     sticks with its first row above the top of the screen. */
  @media (max-width: 720px) {
    .site-header {
      --wordmark-row: 46px;
      top: calc(var(--wordmark-row) * -1);
    }
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: var(--wordmark-row) var(--header-height);
      height: auto;
      column-gap: 8px;
    }
    .wordmark {
      grid-column: 1 / -1;
      align-self: end;
      padding-bottom: 4px;
    }
    .site-nav {
      grid-row: 2;
      gap: clamp(12px, 4.6vw, 26px);
    }
    .header-tools {
      grid-column: 2;
      grid-row: 2;
      margin-right: -8px;
    }
    .header-tools :global(.icon-button) {
      width: 36px;
      height: 36px;
    }
  }
  @media print {
    .site-header {
      display: none;
    }
  }
</style>
