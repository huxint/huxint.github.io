---
import Icon from './Icon.astro';
---

<button
  class="icon-button theme-toggle"
  type="button"
  aria-label="切换主题"
  title="切换主题"
  data-theme-toggle
>
  <span class="theme-moon"><Icon name="moon" size={19} /></span>
  <span class="theme-sun"><Icon name="sun" size={19} /></span>
</button>

<style>
  .theme-toggle {
    display: none;
    position: relative;
  }
  :global(.js) .theme-toggle {
    display: inline-flex;
  }
  .theme-moon,
  .theme-sun {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      opacity var(--dur-base) ease,
      transform 360ms var(--ease-spring);
  }
  .theme-sun {
    opacity: 0;
    transform: rotate(-35deg) scale(0.64);
  }
  :global([data-theme='dark']) .theme-moon {
    opacity: 0;
    transform: rotate(30deg) scale(0.64);
  }
  :global([data-theme='dark']) .theme-sun {
    opacity: 1;
    transform: none;
  }
</style>
