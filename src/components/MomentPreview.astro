---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate } from '../lib/posts';
import {
  momentCounts,
  momentDate,
  momentExcerpt,
  momentImages,
  type Moment,
} from '../lib/life';

interface Props {
  moment: Moment;
}
const { moment } = Astro.props;
const date = formatDate(moment.data.date);
const { weekday } = momentDate(moment);
const images = momentImages(moment).slice(0, 3);
const { photos, videos } = momentCounts(moment);
const media = [photos && `${photos} 张照片`, videos && `${videos} 段视频`]
  .filter(Boolean)
  .join('，');
---

<a
  class:list={['moment-preview', images.length ? 'is-photo' : 'is-note']}
  href={`/life/${moment.id}/`}
  id={moment.id}
  aria-label={`${date} 的记录`}
>
  <div class="moment-preview-meta">
    <div class="moment-preview-date">
      <time datetime={moment.data.date.toISOString()}>{date.slice(5)}</time>
      <span>{weekday}</span>
    </div>
    <div class="moment-preview-place">
      {
        moment.data.location && (
          <span class="moment-location">
            <Icon name="pin" size={13} />
            {moment.data.location}
          </span>
        )
      }
      {moment.data.draft && <span class="draft-badge">草稿</span>}
    </div>
  </div>
  {
    images.length > 0 && (
      <div class="moment-preview-prints" data-count={images.length}>
        {images.map((image) => (
          <div class="moment-print">
            <Image
              src={image}
              alt=""
              width={480}
              widths={[240, 360, 480, 720]}
              sizes="(max-width: 640px) 35vw, 260px"
              format="webp"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    )
  }
  <div class="moment-preview-copy">
    <p class="moment-preview-excerpt">{momentExcerpt(moment, 140)}</p>
    <div class="moment-preview-footer">
      {media && <span class="moment-preview-count">{media}</span>}
      <span class="moment-preview-read">
        查看记录 <Icon name="chevron" size={14} />
      </span>
    </div>
  </div>
</a>
