---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, shortDate } from '../lib/posts';
import {
  momentExcerpt,
  momentMedia,
  momentWeekday,
  type Moment,
} from '../lib/life';

interface Props {
  moment: Moment;
}
const { moment } = Astro.props;
const { date, location, draft } = moment.data;
const { images, photos, videos } = momentMedia(moment);
const media = [photos && `${photos} 张照片`, videos && `${videos} 段视频`]
  .filter(Boolean)
  .join('，');
---

<a
  class:list={['year-entry moment-preview', { 'is-note': !images.length }]}
  href={`/life/${moment.id}/`}
  id={moment.id}
  aria-label={`${formatDate(date)} 的记录`}
>
  <p class="entry-date">
    <time datetime={date.toISOString()}>{shortDate(date)}</time>
    <span>{[momentWeekday(moment), location].filter(Boolean).join(' · ')}</span>
    {draft && <span class="draft-badge">草稿</span>}
  </p>
  <div class="moment-preview-body">
    {
      images.length > 0 && (
        <div class="moment-preview-prints">
          {images.slice(0, 3).map((image) => (
            <Image
              src={image}
              alt=""
              width={480}
              widths={[240, 360, 480]}
              sizes="(max-width: 720px) 32vw, 236px"
              format="webp"
              loading="lazy"
            />
          ))}
        </div>
      )
    }
    <p class="moment-preview-excerpt">{momentExcerpt(moment, 140)}</p>
    <p class="moment-preview-footer">
      {media && <span>{media}</span>}
      <span class="moment-preview-read action-link is-primary">
        查看记录 <Icon name="arrow" size={14} />
      </span>
    </p>
  </div>
</a>

<style>
  /* Up to three photos and the opening lines; the date sits in the rail. */
  .moment-preview {
    align-items: start;
    padding-block: 18px 20px;
  }
  .moment-preview.is-note {
    align-items: baseline;
  }
  .entry-date time {
    color: var(--text);
    transition: color var(--dur-fast) ease;
  }
  .draft-badge {
    margin-top: 6px;
  }
  .moment-preview-body {
    min-width: 0;
    max-width: var(--measure);
  }
  .moment-preview-prints {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin-bottom: 14px;
  }
  .moment-preview-prints :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xs);
    background: var(--surface);
    transition: filter 300ms ease;
  }
  .moment-preview-prints :global(img:first-child) {
    border-top-left-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
  }
  .moment-preview-prints :global(img:last-child) {
    border-top-right-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
  }
  .moment-preview-excerpt {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-height: var(--leading-body);
  }
  .moment-preview-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
    margin-top: 6px;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
  }
  .moment-preview-read {
    min-height: 32px;
  }
  .moment-preview:hover .entry-date time {
    color: var(--accent-ink);
  }
  .moment-preview:hover .moment-preview-prints :global(img) {
    filter: brightness(1.04) saturate(1.04);
  }
  .moment-preview:hover .moment-preview-read :global(svg) {
    transform: translateX(3px);
  }
  .moment-preview:focus-visible {
    outline-offset: 6px;
  }
  @media (max-width: 720px) {
    .moment-preview {
      padding-block: 14px 16px;
    }
    .moment-preview-prints {
      gap: 4px;
      margin-bottom: 10px;
    }
    .moment-preview-excerpt {
      font-size: var(--text-md);
    }
  }
</style>
