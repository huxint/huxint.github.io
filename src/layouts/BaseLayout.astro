---
// The optical-size axis gives headings Inter's display cut and text its text cut.
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
  image?: { src: string; width: number; height: number; alt: string };
}
const {
  title,
  description = site.description,
  article = false,
  noindex = false,
  image = {
    src: '/images/gorilla-share.webp',
    width: 640,
    height: 640,
    alt: '灰色小猩猩头像',
  },
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SiteHead
      title={pageTitle}
      description={description}
      image={image}
      article={article}
      rss
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body id="top">
    <Header />
    <slot />
    <Footer />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
