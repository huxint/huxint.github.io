---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { groups, stickers } from '../../lib/stickers/catalog.mjs';
import '../../styles/stickers.css';
---

<BaseLayout
  title="表情"
  description="huxint 博客的大猩猩表情：在文章里写 :名字: 就会显示对应的贴纸。"
>
  <main class="page" id="main">
    <PageHeader title="表情">
      <p class="lede">
        在文章、标题和描述里写 <code>:名字:</code
        >，就会换成对应的大猩猩。带字的梗图在文字里显示得更大，单独占一行时都会放大。
      </p>
    </PageHeader>
    <div class="sticker-toolbar rail-grid">
      <div class="sticker-filter">
        <label class="field sticker-search">
          <Icon name="search" size={16} />
          <span class="sr-only">筛选表情</span>
          <input
            type="search"
            placeholder="筛选名字、配字或写法"
            autocomplete="off"
            spellcheck="false"
            data-sticker-filter
            data-shortcut-focus
          />
          <kbd class="key" aria-hidden="true">/</kbd>
        </label>
        <p class="sticker-count" data-sticker-count>
          共 {stickers.length} 个，点一下复制写法。
        </p>
      </div>
    </div>
    {
      groups.map((group) => {
        const members = stickers.filter(({ group: id }) => id === group.id);
        return (
          <section
            class="sticker-group rail-grid"
            aria-labelledby={group.id}
            data-sticker-group
          >
            <h2 class="rail label" id={group.id}>
              {group.label}
              <small>{members.length} 个</small>
            </h2>
            <ul class="sticker-grid">
              {members.map((sticker) => (
                <li
                  data-sticker-item
                  data-sticker-search={[
                    sticker.id,
                    sticker.label,
                    sticker.caption,
                    group.label,
                  ]
                    .filter(Boolean)
                    .join(' ')}
                >
                  <button
                    class="sticker-card"
                    type="button"
                    data-sticker-code={`:${sticker.id}:`}
                  >
                    <img
                      src={`/stickers/${sticker.id}.svg`}
                      alt=""
                      width="88"
                      height="88"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="sticker-name">{sticker.label}</span>
                    <code>:{sticker.id}:</code>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
    <div class="sticker-empty rail-grid" data-sticker-empty hidden>
      <p>没有找到对应的表情。</p>
    </div>
    <p class="sr-only" role="status" data-sticker-status></p>
  </main>
  <script>
    import '../../scripts/stickers';
  </script>
</BaseLayout>
