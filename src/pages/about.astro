---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClaudeCode from '../icons/claude-code.svg';
import Codex from '../icons/codex.svg';
import DeepSeek from '../icons/deepseek.svg';
import GitHub from '../icons/github.svg';
import Gmail from '../icons/gmail.svg';
import X from '../icons/x.svg';
import { site } from '../data/site';

const contacts = [
  {
    name: 'Gmail',
    account: site.email,
    href: `mailto:${site.email}`,
    icon: Gmail,
    glyphSize: 28,
  },
  {
    name: 'GitHub',
    account: 'huxint',
    href: site.github,
    icon: GitHub,
    glyphSize: 28,
  },
  {
    name: 'X',
    account: '@huxint123',
    href: site.x,
    icon: X,
    glyphSize: 25,
  },
];
const tools = [
  {
    name: 'Claude Code',
    href: 'https://code.claude.com/',
    icon: ClaudeCode,
    glyphSize: 32,
  },
  {
    name: 'Codex',
    href: 'https://openai.com/codex/',
    icon: Codex,
    glyphSize: 28,
  },
  {
    name: 'DeepSeek Harness',
    href: 'https://github.com/deepseek-ai/deepseek-harness',
    icon: DeepSeek,
    glyphSize: 32,
  },
];
---

<BaseLayout
  title="关于我"
  description="huxint，江西师范大学人工智能专业本科生。"
>
  <main class="page profile-page" id="main">
    <header class="profile-heading">
      <h1>huxint</h1>
      <img
        class="profile-avatar"
        src="/images/gorilla.webp"
        width="176"
        height="176"
        alt="银背猩猩头像"
      />
      <a class="profile-school" href="https://www.jxnu.edu.cn/">
        <span class="brand-icon" aria-hidden="true">
          <span class="school-emblem"></span>
        </span>
        <span>
          <span class="school-name">江西师范大学</span>
          <span class="profile-secondary">人工智能专业，本科在读</span>
        </span>
      </a>
    </header>

    <div class="profile-links">
      <section aria-labelledby="contacts-heading">
        <h2 id="contacts-heading">联系我</h2>
        <ul class="profile-contacts">
          {
            contacts.map(
              ({ name, account, href, icon: ContactIcon, glyphSize }) => (
                <li>
                  <a href={href} class="profile-link">
                    <span
                      class="brand-icon"
                      style={`--glyph-size: ${glyphSize}px`}
                    >
                      <ContactIcon aria-hidden="true" />
                    </span>
                    <span>
                      <span class="profile-label">{name}</span>
                      <span class="profile-secondary">{account}</span>
                    </span>
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </section>
      <section class="profile-workbench" aria-labelledby="tools-heading">
        <h2 id="tools-heading">常用 Agent</h2>
        <ul class="profile-tools">
          {
            tools.map(({ name, href, icon: ToolIcon, glyphSize }) => (
              <li>
                <a href={href} class="profile-link">
                  <span
                    class="brand-icon"
                    style={`--glyph-size: ${glyphSize}px`}
                  >
                    <ToolIcon aria-hidden="true" />
                  </span>
                  <span class="profile-label">{name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .profile-page {
    width: min(100% - 48px, 800px);
    padding-top: 80px;
  }
  .profile-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 176px;
    grid-template-areas: 'name portrait' 'school portrait';
    align-items: center;
    gap: 28px 48px;
  }
  .profile-heading h1 {
    grid-area: name;
    font-size: clamp(80px, 10vw, 120px);
    font-weight: 560;
    line-height: 0.95;
    letter-spacing: -0.075em;
  }
  .profile-avatar {
    grid-area: portrait;
    display: block;
    width: 176px;
    height: 176px;
    border-radius: 36px;
    background: var(--portrait-bg);
    transform: rotate(4deg);
  }
  .profile-school {
    grid-area: school;
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 12px;
    min-height: 52px;
  }
  .school-name,
  .profile-label {
    display: block;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.6;
  }
  .profile-secondary {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }
  .brand-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--bg-raised);
  }
  .brand-icon :global(svg) {
    width: var(--glyph-size, 26px);
    height: var(--glyph-size, 26px);
  }
  .brand-icon :global(.deepseek-mark) {
    translate: 1px 1px;
  }
  .school-emblem {
    width: 32px;
    height: 32px;
    background: #aa4e4f;
    mask: url('/images/jxnu-emblem.webp') center / contain no-repeat;
  }
  :global([data-theme='dark']) .school-emblem {
    background: #d88d8f;
  }
  .profile-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .profile-links h2 {
    margin-bottom: 16px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 450;
  }
  .profile-workbench {
    padding-left: 48px;
    border-left: 1px solid var(--rule);
  }
  .profile-link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding-block: 8px;
  }
  .profile-link:hover .profile-label,
  .profile-school:hover .school-name {
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 5px;
  }
  @media (max-width: 640px) {
    .profile-page {
      width: calc(100% - 40px);
      max-width: 480px;
      padding-top: 44px;
    }
    .profile-heading {
      grid-template-columns: minmax(0, 1fr) 80px;
      grid-template-areas: 'name portrait' 'school school';
      gap: 24px 20px;
    }
    .profile-heading h1 {
      font-size: clamp(50px, 16vw, 76px);
    }
    .profile-avatar {
      width: 80px;
      height: 80px;
      border-radius: 20px;
    }
    .profile-links {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 28px;
      padding-top: 24px;
    }
    .profile-contacts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
    }
    .profile-contacts li:first-child {
      grid-column: 1 / -1;
    }
    .profile-workbench {
      padding-left: 0;
      border-left: 0;
    }
    .profile-tools {
      display: grid;
      grid-template-columns: 1fr 1fr 1.2fr;
      gap: 16px;
    }
    .profile-tools .profile-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .profile-tools .profile-label {
      font-size: 13px;
    }
  }
</style>
