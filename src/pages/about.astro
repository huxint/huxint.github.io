---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ClaudeCode from '../icons/claude-code.svg';
import Codex from '../icons/codex.svg';
import DeepSeek from '../icons/deepseek.svg';
import GitHub from '../icons/github.svg';
import Gmail from '../icons/gmail.svg';
import X from '../icons/x.svg';
import { site } from '../data/site';
import { getContributionCalendar } from '../lib/contributions';

const sections = [
  {
    id: 'contacts',
    title: '联系我',
    links: [
      {
        name: 'Gmail',
        detail: site.email,
        href: `mailto:${site.email}`,
        icon: Gmail,
        size: 26,
      },
      {
        name: 'GitHub',
        detail: 'huxint',
        href: site.github,
        icon: GitHub,
        size: 26,
      },
      { name: 'X', detail: '@huxint123', href: site.x, icon: X, size: 23 },
    ],
  },
  {
    id: 'agents',
    title: '常用 Agent',
    links: [
      {
        name: 'Claude Code',
        detail: 'Anthropic',
        href: 'https://code.claude.com/',
        icon: ClaudeCode,
        size: 30,
      },
      {
        name: 'Codex',
        detail: 'OpenAI',
        href: 'https://openai.com/codex/',
        icon: Codex,
        size: 26,
      },
      {
        name: 'DeepSeek Harness',
        detail: 'DeepSeek',
        href: 'https://github.com/deepseek-ai/deepseek-harness',
        icon: DeepSeek,
        size: 30,
      },
    ],
  },
];
const calendar = await getContributionCalendar('huxint');
---

<BaseLayout
  title="关于我"
  description="huxint，江西师范大学人工智能专业本科生。"
>
  <main class="page" id="main">
    <header class="about-intro">
      <div class="intro-text">
        <h1>{site.name}<span>.</span></h1>
        <a class="school" href="https://www.jxnu.edu.cn/">
          <span class="school-emblem" aria-hidden="true"></span>
          <span>江西师范大学 · 人工智能专业，本科在读</span>
        </a>
        <p class="intro">日常记录</p>
      </div>
      <div class="stamp">
        <img
          src="/images/gorilla-portrait.webp"
          width="640"
          height="640"
          alt="拿着橙色笔记本的银背猩猩"
        />
      </div>
    </header>

    {
      sections.map(({ id, title, links }) => (
        <section class="about-section" aria-labelledby={`${id}-heading`}>
          <h2 id={`${id}-heading`}>{title}</h2>
          <ul class="links">
            {links.map(({ name, detail, href, icon: Glyph, size }) => (
              <li>
                <a href={href}>
                  <span class="glyph" style={`--glyph-size: ${size}px`}>
                    <Glyph aria-hidden="true" />
                  </span>
                  <span class="link-name">
                    {name}
                    <Icon name="external" size={13} />
                  </span>
                  <span class="link-detail">{detail}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      calendar && (
        <section class="about-section" aria-labelledby="github-heading">
          <h2 id="github-heading">GitHub</h2>
          <figure class="calendar">
            <figcaption data-calendar-caption>
              过去一年 {calendar.total.toLocaleString('zh-CN')} 次贡献
            </figcaption>
            <div class="calendar-scroll">
              <div
                class="calendar-body"
                style={`--weeks: ${calendar.weeks}`}
                aria-hidden="true"
              >
                <div class="calendar-months">
                  {calendar.months.map(({ week, label }) => (
                    <span style={`grid-column: ${week + 1}`}>{label}</span>
                  ))}
                </div>
                <div class="calendar-days" data-calendar-days>
                  {calendar.days.map(({ date, level, count }, index) => (
                    <span
                      style={
                        index === 0
                          ? `grid-row-start: ${calendar.offset + 1}`
                          : undefined
                      }
                      data-level={level}
                      data-date={date.replaceAll('-', '.')}
                      data-count={count}
                    />
                  ))}
                </div>
              </div>
            </div>
          </figure>
        </section>
      )
    }
  </main>
</BaseLayout>

<script>
  const caption = document.querySelector('[data-calendar-caption]');
  const days = document.querySelector('[data-calendar-days]');
  if (caption && days) {
    const total = caption.textContent;
    days.addEventListener('pointerover', ({ target }) => {
      const { date, count } = (target as HTMLElement).dataset;
      if (date) caption.textContent = `${date} · ${count} 次贡献`;
    });
    days.addEventListener('pointerleave', () => {
      caption.textContent = total;
    });
  }
</script>

<style>
  .about-intro,
  .about-section {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--gutter);
  }

  .about-intro {
    grid-template-columns: var(--rail) minmax(0, 1fr) auto;
    align-items: center;
    padding: 8px 0 64px;
  }
  .intro-text {
    grid-column: 2;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(48px, 6vw, 68px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  h1 span {
    color: var(--accent);
  }
  .school {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    font-size: 15px;
    transition: color var(--dur-fast) ease;
  }
  .school:hover {
    color: var(--accent-ink);
  }
  .school-emblem {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    background: #aa4e4f;
    mask: url('/images/jxnu-emblem.webp') center / contain no-repeat;
  }
  :global([data-theme='dark']) .school-emblem {
    background: #d88d8f;
  }
  .intro {
    margin-top: 8px;
    color: var(--muted);
    font-size: 16px;
  }

  /* The avatar is a postage stamp in the envelope's top-right corner, its
     scalloped paper edge drawn by a grid of transparent circles. */
  .stamp {
    --hole: 4px;
    --paper: #fffdf8;
    width: 148px;
    padding: 11px;
    background:
      radial-gradient(var(--hole), #0000 98%, var(--paper)) round
        calc(var(--hole) * -1.5) calc(var(--hole) * -1.5) /
        calc(var(--hole) * 3) calc(var(--hole) * 3),
      linear-gradient(var(--paper) 0 0) no-repeat 50% /
        calc(100% - var(--hole) * 3) calc(100% - var(--hole) * 3);
    filter: drop-shadow(0 1px 1px rgb(40 30 10 / 0.14))
      drop-shadow(0 10px 18px rgb(40 30 10 / 0.1));
    rotate: 4deg;
    transition: rotate 420ms var(--ease-spring);
  }
  .stamp:hover {
    rotate: 0deg;
  }
  .stamp img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 75%;
    background: #f0dcc6;
  }
  :global([data-theme='dark']) .stamp {
    --paper: #2b2a30;
    filter: drop-shadow(0 12px 20px rgb(0 0 0 / 0.45));
  }
  :global([data-theme='dark']) .stamp img {
    background: #3a2f27;
  }

  .about-section {
    align-items: start;
    padding-block: 30px;
    border-top: 1px solid var(--rule);
  }
  .about-section:last-child {
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    justify-self: end;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    line-height: 24px;
    white-space: nowrap;
  }
  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px 24px;
  }
  .links a {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    column-gap: 14px;
    align-items: center;
  }
  .glyph {
    grid-row: span 2;
    display: grid;
    place-items: center;
    height: 32px;
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .glyph :global(svg) {
    width: var(--glyph-size);
    height: var(--glyph-size);
  }
  .glyph :global(.deepseek-mark) {
    translate: 1px 1px;
  }
  .link-name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 550;
    line-height: 24px;
    transition: color var(--dur-fast) ease;
  }
  .link-name :global(svg) {
    color: var(--faint);
    opacity: 0;
    transform: translate(-3px, 3px);
    transition:
      opacity var(--dur-fast) ease,
      transform var(--dur-base) var(--ease-spring);
  }
  .link-detail {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .links a:hover .glyph {
    transform: translateY(-2px) rotate(-6deg);
  }
  .links a:hover .link-name {
    color: var(--accent-ink);
  }
  .links a:hover .link-name :global(svg) {
    opacity: 1;
    transform: none;
  }

  .calendar figcaption {
    color: var(--muted);
    font-size: 14px;
    line-height: 24px;
    font-variant-numeric: tabular-nums;
  }
  .calendar-scroll {
    display: flex;
    flex-direction: row-reverse;
    margin-top: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .calendar-body {
    flex: 1;
    --columns: repeat(var(--weeks), minmax(0, 1fr));
  }
  .calendar-months,
  .calendar-days {
    display: grid;
    grid-template-columns: var(--columns);
    column-gap: 3px;
  }
  .calendar-months {
    margin-bottom: 6px;
    color: var(--faint);
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
  }
  .calendar-days {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: 3px;
  }
  .calendar-days span {
    aspect-ratio: 1;
    border-radius: 2px;
    background: color-mix(in srgb, var(--text) 7%, var(--bg));
  }
  .calendar-days [data-level='1'] {
    background: color-mix(in srgb, var(--accent) 30%, var(--bg));
  }
  .calendar-days [data-level='2'] {
    background: color-mix(in srgb, var(--accent) 55%, var(--bg));
  }
  .calendar-days [data-level='3'] {
    background: color-mix(in srgb, var(--accent) 78%, var(--bg));
  }
  .calendar-days [data-level='4'] {
    background: var(--accent-ink);
  }
  .calendar-days span:hover {
    outline: 1.5px solid var(--text);
    outline-offset: 1px;
  }

  @media (max-width: 720px) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 20px;
      padding: 0 0 40px;
    }
    .intro-text {
      grid-column: 1;
    }
    h1 {
      font-size: 44px;
    }
    .school {
      align-items: flex-start;
      font-size: 14px;
      word-break: keep-all;
    }
    .stamp {
      --hole: 3px;
      width: 96px;
      padding: 7px;
    }
    .about-section {
      display: block;
      padding-block: 20px 24px;
    }
    h2 {
      justify-self: start;
      margin-bottom: 12px;
    }
    .links {
      gap: 14px;
    }
    .calendar-body {
      flex: none;
      --columns: repeat(var(--weeks), 10px);
    }
  }
</style>
