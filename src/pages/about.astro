---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClaudeCode from '../icons/claude-code.svg';
import Codex from '../icons/codex.svg';
import DeepSeek from '../icons/deepseek.svg';
import GitHub from '../icons/github.svg';
import Gmail from '../icons/gmail.svg';
import X from '../icons/x.svg';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { formatDate, getPosts } from '../lib/posts';
import { getMoments } from '../lib/life';

const contacts = [
  {
    name: 'Gmail',
    account: site.email,
    href: `mailto:${site.email}`,
    icon: Gmail,
    glyphSize: 24,
  },
  {
    name: 'GitHub',
    account: 'huxint',
    href: site.github,
    icon: GitHub,
    glyphSize: 24,
  },
  {
    name: 'X',
    account: '@huxint123',
    href: site.x,
    icon: X,
    glyphSize: 21,
  },
];
const tools = [
  {
    name: 'Claude Code',
    href: 'https://code.claude.com/',
    icon: ClaudeCode,
    glyphSize: 28,
  },
  {
    name: 'Codex',
    href: 'https://openai.com/codex/',
    icon: Codex,
    glyphSize: 24,
  },
  {
    name: 'DeepSeek Harness',
    href: 'https://github.com/deepseek-ai/deepseek-harness',
    icon: DeepSeek,
    glyphSize: 28,
  },
];
const posts = await getPosts();
const moments = await getMoments();
const latest = posts[0];
const first = posts.at(-1);
---

<BaseLayout
  title="关于我"
  description="huxint，江西师范大学人工智能专业本科生。"
>
  <main class="page" id="main">
    <header class="about-intro">
      <img
        class="avatar"
        src="/images/gorilla.webp"
        width="148"
        height="148"
        alt="银背猩猩头像"
      />
      <div>
        <h1>{site.name}</h1>
        <a class="school" href="https://www.jxnu.edu.cn/">
          <span class="school-emblem" aria-hidden="true"></span>
          江西师范大学 · 人工智能专业，本科在读
        </a>
        <p class="intro">写算法题解、C++ 和机器学习笔记，也记一点日常。</p>
      </div>
    </header>

    <section class="about-section" aria-labelledby="contacts-heading">
      <h2 id="contacts-heading">联系我</h2>
      <ul class="contacts">
        {
          contacts.map(
            ({ name, account, href, icon: ContactIcon, glyphSize }) => (
              <li>
                <a href={href}>
                  <span
                    class="brand-icon"
                    style={`--glyph-size: ${glyphSize}px`}
                  >
                    <ContactIcon aria-hidden="true" />
                  </span>
                  <span class="contact-name">{name}</span>
                  <span class="contact-account">{account}</span>
                </a>
              </li>
            ),
          )
        }
      </ul>
    </section>

    <section class="about-section" aria-labelledby="tools-heading">
      <h2 id="tools-heading">常用 Agent</h2>
      <ul class="tools">
        {
          tools.map(({ name, href, icon: ToolIcon, glyphSize }) => (
            <li>
              <a href={href}>
                <span class="brand-icon" style={`--glyph-size: ${glyphSize}px`}>
                  <ToolIcon aria-hidden="true" />
                </span>
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      latest && first && (
        <section class="about-section" aria-labelledby="site-heading">
          <h2 id="site-heading">这个博客</h2>
          <div class="site-facts">
            <p>
              <a href="/">{posts.length} 篇文章</a>、
              <a href="/life/">{moments.length} 条生活记录</a>、
              <a href="/projects/">{projects.length} 个项目</a>，第一篇写于{' '}
              {formatDate(first.data.pubDate)}。
            </p>
            <p>
              最近一篇是《
              <a href={`/posts/${latest.id}/`}>{latest.data.title}</a>
              》，可以通过 <a href="/rss.xml">RSS</a> 订阅更新。
            </p>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .about-intro,
  .about-section {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--gutter);
  }
  .about-intro {
    align-items: center;
    padding-bottom: 56px;
  }
  .avatar {
    justify-self: end;
    width: min(148px, 100%);
    height: auto;
    border-radius: 32px;
    background: var(--portrait-bg);
    transform: rotate(4deg);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(44px, 5vw, 56px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .school {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font-size: 15px;
    transition: color var(--dur-fast) ease;
  }
  .school:hover {
    color: var(--accent-ink);
  }
  .school-emblem {
    width: 26px;
    height: 26px;
    background: #aa4e4f;
    mask: url('/images/jxnu-emblem.webp') center / contain no-repeat;
  }
  :global([data-theme='dark']) .school-emblem {
    background: #d88d8f;
  }
  .intro {
    max-width: 32em;
    margin-top: 10px;
    color: var(--muted);
    font-size: 16px;
  }

  .about-section {
    align-items: baseline;
    padding-block: 26px;
    border-top: 1px solid var(--rule);
  }
  .about-section:last-child {
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    justify-self: end;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .brand-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid var(--rule);
    border-radius: 11px;
    background: var(--bg-raised);
  }
  .brand-icon :global(svg) {
    width: var(--glyph-size);
    height: var(--glyph-size);
  }
  .brand-icon :global(.deepseek-mark) {
    translate: 1px 1px;
  }

  .contacts {
    display: grid;
    gap: 6px;
  }
  .contacts a {
    display: grid;
    grid-template-columns: 40px 64px minmax(0, 1fr);
    column-gap: 16px;
    align-items: center;
    min-height: 48px;
  }
  .contact-name {
    font-weight: 550;
  }
  .contact-account {
    color: var(--muted);
    font-size: 15px;
    overflow-wrap: anywhere;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
  }
  .tools a {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 48px;
    font-weight: 550;
  }
  .contacts a:hover,
  .contacts a:hover .contact-account,
  .tools a:hover {
    color: var(--accent-ink);
  }
  .site-facts {
    max-width: var(--measure);
    color: var(--muted);
    line-height: 1.9;
  }
  .site-facts a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 4px;
    transition:
      color var(--dur-fast) ease,
      text-decoration-color var(--dur-fast) ease;
  }
  .site-facts a:hover {
    color: var(--accent-ink);
    text-decoration-color: var(--accent);
  }
  .site-facts p + p {
    margin-top: 6px;
  }

  @media (max-width: 720px) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr) 88px;
      column-gap: 20px;
      padding-bottom: 36px;
    }
    .avatar {
      grid-area: 1 / 2;
      align-self: start;
      border-radius: 22px;
    }
    .about-intro > div {
      grid-area: 1 / 1;
    }
    h1 {
      font-size: 42px;
    }
    .school {
      align-items: flex-start;
      font-size: 14px;
    }
    .about-section {
      display: block;
      padding-block: 20px 22px;
    }
    h2 {
      justify-self: start;
      margin-bottom: 10px;
    }
    .contacts a {
      grid-template-columns: 40px 56px minmax(0, 1fr);
      column-gap: 12px;
    }
    .contact-account {
      font-size: 14px;
    }
    .tools {
      gap: 4px 24px;
    }
  }
</style>
