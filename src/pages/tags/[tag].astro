---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import {
  formatDate,
  getPosts,
  getTags,
  tagHref,
  type Post,
} from '../../lib/posts';
import '../../styles/tags.css';
export const getStaticPaths = (async () => {
  const tags = getTags(await getPosts());
  return tags.map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts, tags },
  }));
}) satisfies GetStaticPaths;
interface Props {
  tag: string;
  posts: Post[];
  tags: [string, Post[]][];
}
const { tag, posts, tags } = Astro.props;
const related = tags
  .filter(([name]) => name !== tag)
  .map(([name, tagged]) => ({
    tag: name,
    shared: tagged.filter((post) => posts.includes(post)).length,
    count: tagged.length,
  }))
  .filter(({ shared }) => shared > 0)
  .sort(
    (left, right) =>
      right.shared - left.shared ||
      right.count - left.count ||
      left.tag.localeCompare(right.tag, 'zh-CN'),
  )
  .slice(0, 6);
const latest = posts[0];
---

<BaseLayout
  title={`#${tag}`}
  description={`标签「${tag}」下的 ${posts.length} 篇文章。`}
>
  <main class="page" id="main">
    <PageHeader>
      <a slot="rail" class="back-link" href="/tags/">← 所有标签</a>
      <Fragment slot="title"><span class="tag-hash">#</span>{tag}</Fragment>
      <p>
        {posts.length} 篇文章，最近一篇写于 {formatDate(latest.data.pubDate)}。
      </p>
      {
        related.length > 0 && (
          <nav class="tag-related" aria-label="相邻主题">
            <span>常一起出现</span>
            {related.map((item) => (
              <a
                href={tagHref(item.tag)}
                title={`与「${tag}」共同出现在 ${item.shared} 篇文章里`}
              >
                {item.tag}
                <small>{item.shared}</small>
              </a>
            ))}
          </nav>
        )
      }
    </PageHeader>
    <PostList posts={posts} />
  </main>
</BaseLayout>
