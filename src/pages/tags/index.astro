---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, getTags, tagHref } from '../../lib/posts';
import { inlineText } from '../../lib/inline-markdown';
import '../../styles/tags.css';

const tags = getTags(await getPosts());
// One row per article count, most-written topics first.
const tiers = [...Map.groupBy(tags, ([, tagged]) => tagged.length)].sort(
  ([left], [right]) => right - left,
);
const weight = (count: number) =>
  Math.log(count) / Math.log(Math.max(2, tiers[0]?.[0] ?? 2));
---

<BaseLayout
  title="标签"
  description="huxint 博客的标签索引：从题目、算法和技术笔记里，找到继续阅读的线索。"
>
  <main class="page" id="main">
    <PageHeader title="标签">
      <p>从一个主题，找到想读的文章。</p>
    </PageHeader>
    {
      tags.length ? (
        <section class="tag-index" aria-label="全部标签">
          <div class="tag-toolbar rail-grid">
            <div class="tag-filter">
              <label class="tag-search">
                <Icon name="search" size={16} />
                <span class="sr-only">筛选标签</span>
                <input
                  type="search"
                  placeholder="筛选标签或文章标题"
                  autocomplete="off"
                  spellcheck="false"
                  data-tag-filter
                />
                <kbd aria-hidden="true">/</kbd>
              </label>
              <p class="tag-status" role="status" data-tag-status>
                共 {tags.length} 个标签，按文章数分组。
              </p>
            </div>
          </div>
          <ol class="tag-tiers">
            {tiers.map(([count, entries]) => (
              <li
                class="tag-tier"
                style={`--weight: ${weight(count).toFixed(2)}`}
                data-tag-tier
              >
                <p class="tag-tier-count">{count} 篇</p>
                <ul class="tag-tier-tags">
                  {entries.map(([tag, tagged]) => (
                    <li
                      data-tag-item
                      data-tag-search={[
                        tag,
                        ...tagged.map((post) => inlineText(post.data.title)),
                      ].join(' ')}
                    >
                      <a
                        href={tagHref(tag)}
                        aria-label={`${tag}，${count} 篇文章`}
                      >
                        {tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
          <div class="tag-empty rail-grid" data-tag-empty hidden>
            <p>
              没有找到对应的标签。
              <button type="button" data-tag-clear>
                清除筛选
              </button>
            </p>
          </div>
        </section>
      ) : (
        <p class="empty-state">
          还没有标签。
          <a class="text-link" href="/">
            回到文章列表
          </a>
        </p>
      )
    }
  </main>
  <script>
    import '../../scripts/tags';
  </script>
</BaseLayout>
