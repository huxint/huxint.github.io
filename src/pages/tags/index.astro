---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, getTags } from '../../lib/posts';
import '../../styles/tags.css';

const posts = await getPosts();
const tags = getTags(posts).sort(
  ([leftTag, leftPosts], [rightTag, rightPosts]) =>
    rightPosts.length - leftPosts.length ||
    leftTag.localeCompare(rightTag, 'zh-CN'),
);
---

<BaseLayout
  title="标签"
  description="huxint 博客的标签索引：从题目、算法和技术笔记里，找到继续阅读的线索。"
>
  <main class="page tag-index-page" id="main">
    <header class="tag-hero">
      <div>
        <h1>标签</h1>
        <p class="tag-hero-lede">从一个主题，找到想读的文章。</p>
      </div>
      <p class="tag-hero-meta">{posts.length} 篇文章，{tags.length} 个主题</p>
    </header>

    {
      tags.length ? (
        <section class="tag-directory" aria-label="全部标签">
          <div class="tag-toolbar">
            <label class="tag-search">
              <Icon name="search" size={16} />
              <span class="sr-only">筛选标签</span>
              <input
                type="search"
                placeholder="搜索标签或文章…"
                autocomplete="off"
                spellcheck="false"
                data-tag-filter
              />
              <kbd aria-hidden="true">/</kbd>
            </label>
            <p class="tag-toolbar-status" role="status" data-tag-status>
              共 {tags.length} 个标签，按文章数排列。
            </p>
          </div>

          <ol class="tag-list">
            {tags.map(([tag, tagged]) => (
              <li
                class="tag-list-item"
                data-tag-item
                data-tag-search={[
                  tag,
                  ...tagged.map((post) => post.data.title),
                ].join(' ')}
              >
                <a
                  class="tag-entry"
                  href={`/tags/${encodeURIComponent(tag)}/`}
                  aria-label={`${tag}，${tagged.length} 篇文章`}
                >
                  <span class="tag-entry-name">
                    <span class="tag-entry-hash" aria-hidden="true">
                      #
                    </span>
                    {tag}
                  </span>
                  <span class="tag-entry-count">
                    {tagged.length}
                    <small>篇</small>
                  </span>
                </a>
              </li>
            ))}
          </ol>

          <div class="tag-empty" data-tag-empty hidden>
            <p>没有找到对应的标签。</p>
            <button type="button" data-tag-clear>
              清除筛选
            </button>
          </div>
        </section>
      ) : (
        <p class="empty-state">
          还没有标签。
          <a class="text-link" href="/">
            回到文章列表
          </a>
        </p>
      )
    }
  </main>
  <script>
    import '../../scripts/tags';
  </script>
</BaseLayout>
