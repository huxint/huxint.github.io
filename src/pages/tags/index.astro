---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, getTags } from '../../lib/posts';
import '../../styles/tags.css';

const posts = await getPosts();
const tags = getTags(posts).sort(
  ([leftTag, leftPosts], [rightTag, rightPosts]) =>
    rightPosts.length - leftPosts.length ||
    leftTag.localeCompare(rightTag, 'zh-CN'),
);
const years = posts.map((post) => post.data.pubDate.getUTCFullYear());
const yearRange =
  years.length > 0 ? `${Math.min(...years)}—${Math.max(...years)}` : '';
---

<BaseLayout
  title="标签"
  description="huxint 博客的标签索引：从题目、算法和技术笔记里，找到继续阅读的线索。"
>
  <main class="page tag-index-page" id="main">
    <header class="tag-hero">
      <p class="eyebrow">主题索引</p>
      <h1>标签<span>.</span></h1>
      <div class="tag-hero-copy">
        <p class="tag-hero-lede">
          把写过的题目、技术和零散念头收在这里。从一个词开始，继续往下读。
        </p>
        <p class="tag-hero-meta">
          <span>{posts.length} 篇文章</span>
          <span>{tags.length} 个标签</span>
          {yearRange && <span>{yearRange}</span>}
        </p>
      </div>
    </header>

    {
      tags.length ? (
        <section class="tag-directory" aria-label="全部标签">
          <div class="tag-toolbar">
            <label class="tag-search">
              <Icon name="search" size={16} />
              <span class="sr-only">筛选标签</span>
              <input
                type="search"
                placeholder="搜索标签或文章…"
                autocomplete="off"
                spellcheck="false"
                data-tag-filter
              />
              <kbd aria-hidden="true">/</kbd>
            </label>
            <p class="tag-toolbar-status" role="status" data-tag-status>
              共 {tags.length} 个标签，按文章数排列。
            </p>
          </div>

          <ol class="tag-list" data-tag-list>
            {tags.map(([tag, tagged], index) => {
              const latest = tagged[0];
              return (
                <li
                  class="tag-list-item"
                  data-tag-item
                  data-tag-name={tag}
                  data-tag-search={[
                    tag,
                    ...tagged.map((post) => post.data.title),
                  ].join(' ')}
                  style={`--i: ${index}`}
                >
                  <a
                    class="tag-entry"
                    href={`/tags/${encodeURIComponent(tag)}/`}
                    aria-label={`${tag}，${tagged.length} 篇文章`}
                  >
                    <span class="tag-entry-main">
                      <span class="tag-entry-name">
                        <span class="tag-entry-hash" aria-hidden="true">
                          #
                        </span>
                        {tag}
                      </span>
                      {latest && (
                        <span class="tag-entry-latest">
                          {latest.data.title}
                        </span>
                      )}
                    </span>
                    <span class="tag-entry-side">
                      <span class="tag-entry-count">
                        {tagged.length}
                        <small>篇</small>
                      </span>
                      <span class="tag-entry-arrow" aria-hidden="true">
                        <Icon name="arrow" size={15} />
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>

          <div class="tag-empty" data-tag-empty hidden>
            <p>没有找到对应的标签。</p>
            <button type="button" data-tag-clear>
              清除筛选
            </button>
          </div>
        </section>
      ) : (
        <p class="empty-state">
          还没有标签。
          <a class="text-link" href="/">
            回到文章列表
          </a>
        </p>
      )
    }
  </main>
  <script>
    import '../../scripts/tags';
  </script>
</BaseLayout>
