---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../../styles/prose.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import {
  getPosts,
  formatDate,
  readingMinutes,
  type Post,
} from '../../lib/posts';
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, next: posts[index + 1] ?? posts[index - 1] },
  }));
}) satisfies GetStaticPaths;
interface Props {
  post: Post;
  next?: Post;
}
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const structuredArticle = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'huxint',
    url: 'https://github.com/huxint',
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article
  noindex={post.data.draft}
>
  <Fragment slot="head"
    ><meta
      property="article:published_time"
      content={post.data.pubDate.toISOString()}
    /><script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredArticle).replaceAll('<', '\\u003c')}
    /></Fragment
  >
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <main class="post-page" id="main">
    <div class="post-grid">
      <div class="post-content">
        <a class="back-link" href="/">← 所有文章</a>
        <article data-pagefind-body>
          <header class="post-header">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}
                >{formatDate(post.data.pubDate)}</time
              ><span>约 {readingMinutes(post.body)} 分钟</span>{
                post.data.draft && <span>草稿</span>
              }{
                post.data.updatedDate && (
                  <span>更新于 {formatDate(post.data.updatedDate)}</span>
                )
              }
            </div>
            <h1 data-pagefind-meta="title">{post.data.title}</h1>
            <p class="post-description" data-pagefind-meta="description">
              {post.data.description}
            </p>
            <div class="tag-links" data-pagefind-ignore>
              {
                post.data.tags.map((tag) => (
                  <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
                ))
              }
            </div>
          </header>
          {
            toc.length > 0 && (
              <details class="mobile-toc" data-pagefind-ignore>
                <>
                  <summary>本页目录</summary>
                  <ol>
                    {toc.map((heading) => (
                      <li class:list={{ 'toc-nested': heading.depth === 3 }}>
                        <a href={`#${heading.slug}`} data-toc-link>
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                </>
              </details>
            )
          }
          <div class="prose"><Content /></div>
        </article>
        {
          next && (
            <aside class="related-post">
              <>
                <p>继续阅读</p>
                <a href={`/posts/${next.id}/`}>
                  {next.data.title}
                  <Icon name="arrow" size={18} />
                </a>
              </>
            </aside>
          )
        }
        <div class="post-end">
          <a href="/rss.xml">通过 RSS 订阅</a><a href="#top">回到顶部 ↑</a>
        </div>
      </div>
      {
        toc.length > 0 && (
          <aside class="toc-sidebar" data-pagefind-ignore>
            <nav class="toc" aria-label="文章目录">
              <>
                <p class="toc-title">本页目录</p>
                <ol>
                  {toc.map((heading) => (
                    <li class:list={{ 'toc-nested': heading.depth === 3 }}>
                      <a href={`#${heading.slug}`} data-toc-link>
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </>
            </nav>
          </aside>
        )
      }
    </div>
  </main>
  <dialog class="image-viewer" id="image-viewer" aria-label="图片预览">
    <div class="image-viewer-toolbar">
      <p id="image-caption"></p><button
        class="icon-button"
        type="button"
        aria-label="关闭图片"><Icon name="close" /></button
      >
    </div>
    <img id="image-preview" alt="" />
  </dialog>
</BaseLayout>
<script>
  import '../../scripts/article';
</script>
