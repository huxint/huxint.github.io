---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../../styles/prose.css';
import '../../styles/post.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageViewer from '../../components/ImageViewer.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { inlineHtml, inlineText } from '../../lib/inline-markdown';
import {
  getPosts,
  formatDate,
  readingMinutes,
  tagHref,
  type Post,
} from '../../lib/posts';
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;
interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older }: Props = Astro.props;
const neighbours = [
  newer && { post: newer, rel: 'prev', label: '较新' },
  older && { post: older, rel: 'next', label: '较早' },
].filter(Boolean) as { post: Post; rel: string; label: string }[];
const title = inlineText(post.data.title);
const description = inlineText(post.data.description);
const { Content, headings } = await render(post);
const toc = headings.filter(
  ({ depth, slug }) =>
    (depth === 2 || depth === 3) && slug !== 'footnote-label',
);
// Match Pagefind's browser tokenizer; its build-time Chinese dictionary differs.
const searchTitle = Array.from(
  new Intl.Segmenter('zh-CN', { granularity: 'word' }).segment(title),
  ({ segment }) => segment,
).join(' ');
const structuredArticle = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.github,
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={title} description={description} article>
  <Fragment slot="head"
    ><meta
      property="article:published_time"
      content={post.data.pubDate.toISOString()}
    /><script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredArticle).replaceAll('<', '\\u003c')}
    /></Fragment
  >
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <main class="page post-page" id="main">
    <article class="post" data-pagefind-body>
      <div class="post-info" data-pagefind-ignore>
        <a class="back-link" href="/">← 所有文章</a>
        <p class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}
            >{formatDate(post.data.pubDate)}</time
          ><span>约 {readingMinutes(post.body)} 分钟</span>{
            post.data.updatedDate && (
              <span>更新于 {formatDate(post.data.updatedDate)}</span>
            )
          }{post.data.draft && <span class="draft-badge">草稿</span>}
        </p>
      </div>
      <header class="post-header">
        <h1
          class="page-title inline-markdown"
          data-pagefind-meta="title[data-title], titleWords[data-search-title]"
          data-title={title}
          data-search-title={searchTitle}
          set:html={inlineHtml(post.data.title)}
        />
        <p
          class="post-description inline-markdown"
          data-pagefind-meta="description[data-description]"
          data-description={description}
          set:html={inlineHtml(post.data.description)}
        />
        <p class="tag-links" data-pagefind-ignore>
          {post.data.tags.map((tag) => <a href={tagHref(tag)}>{tag}</a>)}
        </p>
      </header>
      {
        toc.length > 0 && (
          <>
            <aside class="toc-sidebar" data-pagefind-ignore>
              <nav class="toc" aria-label="文章目录">
                <p class="toc-title">目录</p>
                <ol>
                  {toc.map((heading) => (
                    <li class:list={{ 'toc-nested': heading.depth === 3 }}>
                      <a href={`#${heading.slug}`} data-toc-link>
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
            <details class="mobile-toc" data-pagefind-ignore>
              <summary>目录</summary>
              <ol>
                {toc.map((heading) => (
                  <li class:list={{ 'toc-nested': heading.depth === 3 }}>
                    <a href={`#${heading.slug}`} data-toc-link>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </>
        )
      }
      <div class="prose"><Content /></div>
    </article>
    <footer class="post-footer" data-pagefind-ignore>
      {
        neighbours.length > 0 && (
          <nav class="pager" aria-label="前后文章">
            {neighbours.map(({ post: neighbour, rel, label }) => (
              <a href={`/posts/${neighbour.id}/`} rel={rel} class={`is-${rel}`}>
                <span class="pager-text">
                  <small>
                    {label} · {formatDate(neighbour.data.pubDate)}
                  </small>
                  <span
                    class="inline-markdown"
                    set:html={inlineHtml(neighbour.data.title)}
                  />
                </span>
              </a>
            ))}
          </nav>
        )
      }
      <p class="post-end">
        <a class="action-link" href="/rss.xml"
          ><Icon name="rss" size={15} />通过 RSS 订阅</a
        ><a class="action-link" href="#top">回到顶部 ↑</a>
      </p>
    </footer>
  </main>
  <ImageViewer />
</BaseLayout>
<script>
  import '../../scripts/article';
</script>
