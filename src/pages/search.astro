---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getPosts } from '../lib/posts';
const hasPosts = (await getPosts()).length > 0;
---

<BaseLayout title="搜索" description="搜索博客文章。" noindex>
  <main class="page" id="main">
    <PageHeader title="搜索" />
    <div class="search rail-grid">
      <div>
        <form class="search-form" role="search" action="/search/">
          <label class="sr-only" for="search-input">搜索文章</label>
          <div class="field is-large">
            <Icon name="search" size={19} />
            <input
              id="search-input"
              name="q"
              type="search"
              placeholder="输入关键词"
              autocomplete="off"
              spellcheck="false"
              disabled={!hasPosts}
              data-shortcut-focus
            />
            <kbd class="key" aria-hidden="true">/</kbd>
          </div>
        </form>
        <div class="search-toolbar">
          <p class="search-status" role="status" aria-live="polite">
            {hasPosts ? '输入关键词开始搜索。' : '目前还没有可搜索的文章。'}
          </p>
          <a class="action-link" href="/tags/">
            按标签浏览 <Icon name="arrow" size={15} />
          </a>
        </div>
        <ol class="search-results"></ol>
        <button class="button more-results" type="button" hidden
          >显示更多</button
        >
        {
          hasPosts && (
            <noscript>
              <p class="empty-state">
                全文搜索需要启用 JavaScript，也可以
                <a class="text-link" href="/tags/">
                  按标签浏览文章
                </a>
                。
              </p>
            </noscript>
          )
        }
      </div>
    </div>
  </main>
</BaseLayout>
{hasPosts && <script>import '../scripts/search';</script>}

<style>
  .search > div {
    max-width: var(--measure);
  }
  .search-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    margin-top: 12px;
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  .search-status {
    color: var(--muted);
  }
  .search-results {
    margin-top: 12px;
  }
  .search-results :global(.search-result) {
    padding-block: 18px;
    border-top: 1px solid var(--rule);
  }
  .search-results :global(.summary) {
    margin-top: 4px;
  }
  .search-results :global(mark) {
    padding: 1px 3px;
    border-radius: var(--radius-xs);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .more-results {
    margin-top: 20px;
  }
</style>
