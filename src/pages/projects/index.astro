---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { readmeIntroduction } from '../../lib/readme';

const introductions = await Promise.all(
  projects.map(async ({ readme }) => {
    try {
      const response = await fetch(readme, {
        signal: AbortSignal.timeout(10_000),
      });
      if (response.ok) return readmeIntroduction(await response.text());
    } catch {
      // Offline builds leave the introduction to the browser.
    }
  }),
);
---

<BaseLayout
  title="项目"
  description="我做的一些项目，内容来自各自仓库的 README。"
>
  <main class="page" id="main">
    <PageHeader title="项目">
      <p class="lede">一些想法，写成了代码。</p>
    </PageHeader>
    <ol class="project-list">
      {
        projects.map((project, index) => (
          <li class="project">
            <p class="project-index figures">
              {String(index + 1).padStart(2, '0')}
            </p>
            <div class="project-body">
              <h2 class="section-title">
                <a href={`/projects/${project.slug}/`}>{project.name}</a>
              </h2>
              <p
                class="project-description"
                data-readme-url={project.readme}
                hidden={!introductions[index]}
              >
                {introductions[index]}
              </p>
              <p class="link-row">
                <a
                  class="action-link is-primary"
                  href={`/projects/${project.slug}/`}
                >
                  阅读 README <Icon name="arrow" size={15} />
                </a>
                <a class="action-link" href={project.repository}>
                  <Icon name="github" size={15} />
                  {project.owner}/{project.name}
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<script>
  import '../../scripts/project-list';
</script>

<style>
  .project {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--gutter);
    align-items: baseline;
    padding-block: 26px 24px;
    border-top: 1px solid var(--rule);
  }
  .project:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .project-index {
    justify-self: end;
    color: var(--faint);
  }
  .project-body {
    max-width: var(--measure);
  }
  .project-description {
    margin-top: 8px;
    color: var(--muted);
  }
  .link-row {
    margin-top: 10px;
  }
  @media (max-width: 720px) {
    .project {
      display: block;
      padding-block: 20px 16px;
    }
    .project-index {
      margin-bottom: 2px;
    }
    .link-row {
      column-gap: 22px;
    }
  }
</style>
