---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="项目"
  description="我做的一些项目，内容来自各自仓库的 README。"
>
  <main class="page projects-page" id="main">
    <header class="page-heading">
      <h1>项目</h1><p>一些想法，写成了代码。</p>
    </header>
    <div class="project-list content-list">
      {
        projects.map((project) => (
          <article class="project-item">
            <div>
              <>
                <h2>
                  <a href={`/projects/${project.slug}/`}>{project.name}</a>
                </h2>
                <p
                  data-project-description
                  data-metadata-url={project.metadata}
                  data-readme-url={project.readme}
                  hidden
                />
              </>
            </div>
            <div class="project-links">
              <>
                <a href={`/projects/${project.slug}/`}>
                  阅读 README <Icon name="arrow" size={15} />
                </a>
                <a
                  href={project.repository}
                  aria-label={`${project.name} GitHub 仓库`}
                >
                  <Icon name="github" size={17} />
                </a>
              </>
            </div>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>

<script>
  import '../../scripts/project-list';
</script>

<style>
  .projects-page {
    width: min(100% - 48px, 800px);
    padding-top: 48px;
  }
  .project-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-block: 27px;
  }
  .project-item + .project-item {
    border-top: 1px solid var(--rule);
  }
  .project-item > div:first-child {
    min-width: 0;
  }
  .project-links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-shrink: 0;
  }
  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    color: var(--muted);
    font-size: 12px;
  }
  .project-item a:hover {
    color: var(--accent-ink);
  }
  @media (max-width: 640px) {
    .projects-page {
      width: calc(100% - 40px);
      padding-top: 32px;
    }
    .project-item {
      display: block;
      padding-block: 24px 18px;
    }
    .project-links {
      gap: 24px;
      margin-top: 12px;
    }
  }
</style>
