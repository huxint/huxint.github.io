---
import '../../styles/life.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MomentPreview from '../../components/MomentPreview.astro';
import {
  getMoments,
  momentDate,
  type Moment as MomentEntry,
} from '../../lib/life';
const moments = await getMoments();
const groups = moments.reduce<{ year: number; moments: MomentEntry[] }[]>(
  (result, moment) => {
    const { year } = momentDate(moment);
    const group = result.at(-1);
    if (group?.year === year) group.moments.push(moment);
    else result.push({ year, moments: [moment] });
    return result;
  },
  [],
);
---

<BaseLayout
  title="生活"
  description="huxint 的生活记录：照片、视频和随手写下的日常。"
>
  <main class="page life-page life-index" id="main">
    <header class="life-hero">
      <h1>生活</h1>
      <p class="life-lead">拍下来的日常。<br />随手写下的只言片语。</p>
    </header>
    {
      moments.length ? (
        <ol class="moment-list" id="life-records" aria-label="日常记录">
          {groups.map((group) => (
            <li class="moment-year-group">
              <h2 class="moment-year">
                <span>{group.year}</span>
                <small>{group.moments.length} 条</small>
              </h2>
              <ol class="moment-previews" aria-label={`${group.year} 年的记录`}>
                {group.moments.map((moment) => (
                  <li>
                    <MomentPreview moment={moment} />
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">
          还没有记录。
          <a class="text-link" href="/">
            先去看看文章
          </a>
        </p>
      )
    }
  </main>
</BaseLayout>
