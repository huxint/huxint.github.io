---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import MomentPreview from '../../components/MomentPreview.astro';
import { getMoments } from '../../lib/life';
import { yearOf } from '../../lib/posts';
const moments = await getMoments();
const groups = Map.groupBy(moments, (moment) => yearOf(moment.data.date));
---

<BaseLayout
  title="生活"
  description="huxint 的生活记录：照片、视频和随手写下的日常。"
>
  <main class="page" id="main">
    <PageHeader title="生活">
      <p class="lede">拍下来的日常，和随手写下的只言片语。</p>
    </PageHeader>
    {
      moments.length ? (
        <>
          {[...groups].map(([year, moments]) => (
            <section class="year-group">
              <p class="year-label">
                {year}
                <small>{moments.length} 条</small>
              </p>
              <ol aria-label={`${year} 年的记录`}>
                {moments.map((moment) => (
                  <li>
                    <MomentPreview moment={moment} />
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </>
      ) : (
        <p class="empty-state">
          还没有记录。
          <a class="text-link" href="/">
            先去看看文章
          </a>
        </p>
      )
    }
  </main>
</BaseLayout>
