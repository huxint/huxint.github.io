---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Gorilla from '../components/Gorilla.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
---

<BaseLayout>
  <main class="page" id="main">
    <header class="home-hero">
      <div class="home-intro">
        <h1>你好，我是 huxint<span>。</span></h1>
        <p>
          江西师范大学人工智能专业本科生。<br />记一些学到的东西，也写日常生活。
        </p>
        <p class="home-links">
          <a href="/about/">关于我 <Icon name="arrow" size={15} /></a>
          <a href={site.github}><Icon name="github" size={15} /> GitHub</a>
        </p>
      </div>
      <Gorilla />
    </header>
    <h2 class="sr-only">文章</h2>
    {
      posts.length ? (
        <PostList posts={posts} headingLevel="h3" />
      ) : (
        <p class="empty-state">文章正在准备中。</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .page {
    padding-top: 40px;
  }
  .home-hero {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr) clamp(240px, 26vw, 300px);
    column-gap: var(--gutter);
    align-items: center;
    padding-bottom: 48px;
  }
  .home-intro {
    grid-column: 2;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(36px, 4.4vw, 48px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  h1 span {
    color: var(--accent);
  }
  .home-intro > p:not(.home-links) {
    max-width: 30em;
    margin-top: 16px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.85;
  }
  .home-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin-top: 24px;
    font-size: 15px;
  }
  .home-links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    transition: color var(--dur-fast) ease;
  }
  .home-links a:first-child {
    color: var(--accent-ink);
    font-weight: 550;
  }
  .home-links a:hover {
    color: var(--accent-ink);
  }
  .home-links a :global(svg) {
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .home-links a:first-child:hover :global(svg) {
    transform: translateX(3px);
  }
  @media (max-width: 860px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) 240px;
    }
    .home-intro {
      grid-column: 1;
    }
  }
  @media (max-width: 720px) {
    .page {
      padding-top: 24px;
    }
    .home-hero {
      grid-template-columns: 1fr;
      justify-items: center;
      padding-bottom: 36px;
      text-align: center;
    }
    .home-hero :global(.gorilla-avatar) {
      grid-row: 1;
      width: 200px;
    }
    h1 {
      margin-top: 4px;
      font-size: clamp(28px, 8vw, 34px);
    }
    .home-intro > p:not(.home-links) {
      margin: 10px auto 0;
      font-size: 15px;
    }
    .home-links {
      justify-content: center;
      margin-top: 14px;
    }
  }
</style>
