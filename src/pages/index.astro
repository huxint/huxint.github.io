---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Gorilla from '../components/Gorilla.astro';
import Icon from '../components/Icon.astro';
import Print from '../components/Print.astro';
import { site } from '../data/site';
import { formatDate, getPosts } from '../lib/posts';
import { getMoments, momentStills, printNote } from '../lib/life';
const posts = await getPosts();
const prints = (await getMoments())
  .flatMap((moment) =>
    momentStills(moment)
      .slice(0, 2)
      .map((still) => ({ still, moment })),
  )
  .slice(0, 4);
---

<BaseLayout>
  <main class="page home-page" id="main">
    <header class="home-hero">
      <div class="home-introduction">
        <p class="eyebrow">个人博客</p>
        <h1>你好，我是 huxint<span>。</span></h1>
        <p class="home-description">
          江西师范大学人工智能专业本科生。记一些学到的东西，也写日常生活。
        </p>
        <div class="home-links">
          <a href="/about/">关于我 <Icon name="arrow" size={16} /></a>
          <a href={site.github}><Icon name="github" size={16} /> GitHub</a>
        </div>
      </div>
      <Gorilla />
    </header>
    {
      prints.length > 0 && (
        <section aria-labelledby="life-title">
          <div class="section-bar">
            <h2 id="life-title">最近的生活</h2>
            <a href="/life/">
              全部记录 <Icon name="arrow" size={14} />
            </a>
          </div>
          <div class="print-row">
            {prints.map(({ still, moment }) => (
              <Print
                still={still}
                href={`/life/${moment.id}/`}
                label={`${formatDate(moment.data.date)} 的记录`}
                note={printNote(moment)}
                sizes="(max-width: 640px) 42vw, 220px"
              />
            ))}
          </div>
        </section>
      )
    }
    <section aria-labelledby="notes-title">
      <div class="section-bar">
        <h2 id="notes-title">
          文章时间线 <span class="section-count"
            >{String(posts.length).padStart(2, '0')}</span
          >
        </h2>
        <a href="/tags/">按标签浏览 <Icon name="arrow" size={14} /></a>
      </div>
      {
        posts.length ? (
          <PostList posts={posts} headingLevel="h3" />
        ) : (
          <p class="empty-state">文章正在准备中。</p>
        )
      }
    </section>
    <p class="home-note">
      通过 <a href="/rss.xml">RSS</a> 订阅更新。
    </p>
  </main>
</BaseLayout>
