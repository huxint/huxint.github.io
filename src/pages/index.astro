---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Gorilla from '../components/Gorilla.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
---

<BaseLayout>
  <main class="page" id="main">
    <header class="home-hero">
      <div class="home-intro">
        <h1 class="hero-title">你好，我是 huxint<span>。</span></h1>
        <p class="home-lede">
          江西师范大学人工智能专业本科生。<br />记一些学到的东西，也写日常生活。
        </p>
        <p class="link-row">
          <a class="action-link is-primary" href="/about/"
            >关于我 <Icon name="arrow" size={15} /></a
          >
          <a class="action-link" href={site.github}
            ><Icon name="github" size={15} /> GitHub</a
          >
          <a class="action-link" href="/rss.xml"
            ><Icon name="rss" size={15} /> RSS</a
          >
        </p>
      </div>
      <Gorilla />
    </header>
    <h2 class="sr-only">文章</h2>
    {
      posts.length ? (
        <PostList posts={posts} headingLevel="h3" />
      ) : (
        <p class="empty-state">文章正在准备中。</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .page {
    padding-top: 40px;
  }
  .home-hero {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr) clamp(240px, 26vw, 300px);
    column-gap: var(--gutter);
    align-items: center;
    padding-bottom: 48px;
  }
  .home-intro {
    grid-column: 2;
  }
  h1 span {
    color: var(--accent);
  }
  .home-lede {
    max-width: 30em;
    margin-top: 16px;
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }
  .link-row {
    margin-top: 22px;
  }
  @media (max-width: 860px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) 240px;
    }
    .home-intro {
      grid-column: 1;
    }
  }
  @media (max-width: 720px) {
    .page {
      padding-top: 20px;
    }
    .home-hero {
      grid-template-columns: 1fr;
      justify-items: center;
      padding-bottom: 32px;
      text-align: center;
    }
    .home-hero :global(.gorilla-avatar) {
      grid-row: 1;
      width: 200px;
    }
    h1 {
      margin-top: 4px;
    }
    .home-lede {
      margin: 10px auto 0;
    }
    .link-row {
      justify-content: center;
      margin-top: 12px;
    }
  }
</style>
