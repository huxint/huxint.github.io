---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="页面未找到" noindex>
  <main class="page" id="main">
    <PageHeader title="页面未找到">
      <p slot="rail" class="error-code figures">404</p>
      <p class="lede">地址可能有误，或文章已经移动。</p>
      <img
        class="sticker is-large"
        src="/stickers/confused.svg"
        alt=""
        width="128"
        height="128"
      />
      <p><a class="text-link" href="/">← 返回文章列表</a></p>
    </PageHeader>
  </main>
</BaseLayout>

<style>
  .error-code {
    text-align: right;
    color: var(--faint);
    letter-spacing: var(--tracking-label);
  }
  .sticker {
    display: block;
    margin: 24px 0 20px -8px;
  }
  @media (max-width: 720px) {
    .error-code {
      text-align: left;
    }
  }
</style>
